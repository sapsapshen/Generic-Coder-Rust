{
  "name": "generic-coder-ui",
  "version": "1.1.2",
  "description": "Generic Coder — Autonomous AI Coding Cockpit",
  "main": "main.js",
  "author": "Generic Coder",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:workbench",
    "build:workbench": "node scripts/build-workbench.mjs",
    "prestart": "npm run build:workbench",
    "prebuild:macos": "npm run build:workbench",
    "prebuild:macos:x64": "npm run build:workbench",
    "prebuild:macos:arm64": "npm run build:workbench",
    "prebuild:windows": "npm run build:workbench",
    "prebuild:all": "npm run build:workbench",
    "start": "node scripts/launch-electron.cjs .",
    "build:macos": "node scripts/run-electron-builder.cjs --mac --x64 --arm64",
    "build:macos:x64": "node scripts/run-electron-builder.cjs --mac --x64",
    "build:macos:arm64": "node scripts/run-electron-builder.cjs --mac --arm64",
    "build:windows": "node scripts/run-electron-builder.cjs --win nsis --x64",
    "build:all": "node scripts/run-electron-builder.cjs --mac --win --x64",
    "print:app-version": "node scripts/resolve-app-version.cjs"
  },
  "build": {
    "appId": "com.generic-coder.ui",
    "productName": "Generic Coder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "!assets/*.md"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "generic-coder-backend*"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${arch}-installer.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "sapsapshen",
        "repo": "Generic-Coder-Rust",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "pkg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "pkg": {
      "artifactName": "${productName}-${version}-${arch}-installer.${ext}",
      "allowAnywhere": true,
      "allowCurrentUserHome": true,
      "allowRootDirectory": true,
      "installLocation": "/Applications",
      "welcome": "build/pkg-welcome.txt",
      "conclusion": "build/pkg-conclusion.txt"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Generic Coder"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "electron-updater": "^6.8.3",
    "monaco-editor": "^0.55.1"
  }
}
